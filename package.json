{
	"name": "trackvault",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.28.4",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm --filter hub dev",
		"build": "pnpm --filter hub build",
		"generate": "pnpm --filter hub generate",
		"seed:bench": "pnpm --filter hub seed:bench",
		"check": "pnpm -r --if-present --reporter append-only run check",
		"lint": "pnpm -r --if-present run lint"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@fcalell/biome-config": "link:../stack/packages/biome-config"
	}
}
