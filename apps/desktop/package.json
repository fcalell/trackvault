{
	"name": "trackvault",
	"productName": "TrackVault",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "dist-electron/index.js",
	"imports": {
		"#components/*": "./src/renderer/components/*.tsx",
		"#lib/*": "./src/renderer/lib/*.ts"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"check-types": "tsc --noEmit --pretty || true",
		"lint": "biome check --write --unsafe",
		"check": "pnpm check-types && pnpm lint",
		"clear": "rm -rf node_modules .turbo dist dist-electron"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@orpc/client": "^1.13.13",
		"@orpc/server": "^1.13.13",
		"@orpc/solid-query": "^1.13.13",
		"@repo/api": "workspace:*",
		"@repo/constants": "workspace:*",
		"@repo/db": "workspace:*",
		"@repo/db-desktop": "workspace:*",
		"@repo/schema": "workspace:*",
		"@repo/ui": "workspace:*",
		"@tanstack/solid-query": "^5.95.2",
		"@tanstack/solid-router": "^1.168.7",
		"@tanstack/solid-table": "^8.21.3",
		"better-sqlite3": "^12.8.0",
		"lucide-solid": "^1.7.0",
		"solid-js": "^1.9"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"@tailwindcss/vite": "^4.2.2",
		"@tanstack/router-plugin": "^1.167.9",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^25.5.0",
		"electron": "^41.1.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.3",
		"vite-plugin-electron": "^0.29.1",
		"vite-plugin-electron-renderer": "^0.14.6",
		"vite-plugin-solid": "^2.11.11"
	}
}
