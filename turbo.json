{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"globalEnv": ["NODE_ENV"],
	"tasks": {
		"//#dev:init": {
			"cache": false,
			"interactive": true
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": ["dist/**", "dist-electron/**"]
		},
		"dev": {
			"dependsOn": ["//#dev:init"],
			"interactive": true,
			"cache": false
		},
		"generate": {
			"cache": false
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		}
	}
}
