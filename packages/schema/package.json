{
	"name": "@repo/schema",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#*": "./src/*.ts"
	},
	"exports": {
		".": "./src/index.ts",
		"./library": "./src/library.ts",
		"./quality": "./src/quality.ts",
		"./settings": "./src/settings.ts",
		"./ipc": "./src/ipc.ts"
	},
	"scripts": {
		"check-types": "tsc --noEmit --pretty || true",
		"lint": "biome check --write --unsafe",
		"check": "pnpm check-types && pnpm lint",
		"clear": "rm -rf node_modules .turbo"
	},
	"dependencies": {
		"@repo/constants": "workspace:*",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"typescript": "^6.0.2"
	}
}
