{
	"name": "@repo/ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"imports": {
		"#components/*": "./src/components/*/index.ts",
		"#lib/*": [
			"./src/lib/*.ts",
			"./src/lib/*.tsx"
		]
	},
	"exports": {
		"./globals.css": "./src/globals.css",
		"./components/*": "./src/components/*/index.ts",
		"./lib/cn": "./src/lib/cn.ts",
		"./lib/create-dialog": "./src/lib/create-dialog.tsx"
	},
	"scripts": {
		"check-types": "tsc --noEmit --pretty || true",
		"lint": "biome check --write --unsafe",
		"check": "pnpm check-types && pnpm lint",
		"clear": "rm -rf node_modules .turbo"
	},
	"peerDependencies": {
		"solid-js": "^1.9"
	},
	"dependencies": {
		"@kobalte/core": "^0.13.11",
		"@tanstack/solid-table": "^8.21.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-solid": "^1.7.0",
		"solid-sonner": "^0.3.1",
		"tailwind-merge": "^3.5.0"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"solid-js": "^1.9",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite-plugin-solid": "^2.11.11"
	}
}
