# /etc/systemd/system/trackvault.service
# The hub as a systemd service, running as its own user from the built bundle.
# See docs/deploy.md.
[Unit]
Description=TrackVault hub
After=network-online.target
Wants=network-online.target

[Service]
User=trackvault
Group=trackvault
# The bundle: `dist/` copied here from the machine that built it (docs/deploy.md).
WorkingDirectory=/opt/trackvault
EnvironmentFile=/etc/trackvault/hub.env
# Migrations are applied by the server before it listens, so there is no step before it.
# PORT and HOST (in the env file) move where it listens.
ExecStart=/usr/bin/node dist/server/server.mjs
Restart=on-failure
RestartSec=5
# SIGTERM stops the services (a running job stays `running` and resumes on the next start).
TimeoutStopSec=30
# The hub writes the database, its caches and the music library; nothing else.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/trackvault /srv/music /srv/trackvault-backups

[Install]
WantedBy=multi-user.target
