# /etc/trackvault/hub.env  (chmod 600, owned by root; the unit reads it)
# The node server refuses to start without these three.
DB_FILE=/var/lib/trackvault/trackvault.sqlite
# At least 32 characters; signs sessions. `openssl rand -base64 36`
AUTH_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# The origin the browser uses, scheme included, no trailing slash. Passkeys bind to its host.
APP_URL=https://trackvault.example.com
# Optional: where the server listens (defaults: every interface, port 8788). Behind Caddy on the
# same box, bind loopback.
#PORT=8788
#HOST=127.0.0.1
