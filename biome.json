{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**/*",
			"!**/*.d.ts",
			"!**/dist",
			"!**/build",
			"!**/node_modules",
			"!**/.turbo",
			"!**/.vite",
			"!**/dist-electron",
			"!**/out",
			"!**/routeTree.gen.ts",
			"!_old_src"
		]
	},
	"formatter": {
		"enabled": true
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		},
		"formatter": {
			"enabled": true
		}
	},
	"overrides": [
		{
			"includes": ["apps/desktop/src/renderer/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@tanstack/solid-query": "Import from '#lib/query' instead."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"apps/desktop/src/renderer/entry.tsx",
				"apps/desktop/src/renderer/lib/query.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		}
	]
}
